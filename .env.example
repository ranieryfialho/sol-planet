# ---- Solplanet (login do app) ----
# é também o login do dashboard
SOLPLANET_ACCOUNT=
SOLPLANET_PASSWORD=
# singapore = Brasil/resto do mundo | germany = UE | china
SOLPLANET_REGION=singapore
SOLPLANET_LOCALE=en

# ---- Postgres existente na VPS ----
# rede docker onde o container do postgres está (docker network ls)
PG_NETWORK=wp-network
# host = nome do container do postgres
DATABASE_URL=postgres://solar_user:SENHA@postgres-db:5432/solar

# ---- Staging ----
# rede docker do Nginx Proxy Manager, à qual o contêiner solar-staging-web se junta (docker network ls)
PROXY_NETWORK=wp-network

# ---- WhatsApp (WAHA) ----
# URL do WAHA que o web e o worker alcançam (o da VPS: nome do container na rede docker, ou https://...)
WAHA_URL=http://waha:3000
# a mesma chave configurada no WAHA (gere uma forte: openssl rand -hex 32)
WAHA_API_KEY=
# cada conta do dashboard pareia o próprio número numa sessão "<prefixo>-<login>-<id da conta>"
WAHA_SESSION_PREFIX=solar
# destinatários iniciais (depois edite em Ajustes no dashboard)
# números (5511999999999) e/ou grupos (1203...@g.us), separados por vírgula
WHATSAPP_TO=

# ---- Dashboard ----
# segredo das sessões e da cifra das senhas das contas (openssl rand -hex 32). Defina em produção:
# sem ele deriva da senha Solplanet principal, e trocá-la invalida sessões e senhas guardadas
# a conta do .env é a administradora (WhatsApp); MAX_ACCOUNTS limita quantas contas Solplanet entram
AUTH_SECRET=
MAX_ACCOUNTS=3
# conta administradora do WhatsApp (padrão: SOLPLANET_ACCOUNT)
ADMIN_ACCOUNT=
# mapa minimalista no fundo da cena da casa (Maps Static API). Opcional: sem a chave, usa tiles do OpenStreetMap
GOOGLE_MAPS_API_KEY=
WEB_BIND=127.0.0.1
WEB_PORT=3010
# endereço público do dashboard (https://seu-dominio, sem barra no fim). Os apps de IA (Claude, ChatGPT, Gemini)
# usam isso para achar o /mcp e o login OAuth. Sem ele o app deduz pelos headers do proxy (Host e X-Forwarded-Proto)
APP_URL=

# ---- Feature flags ----
# FEATURE_MCP liga/desliga o servidor MCP, o OAuth e a página "Conectar IA". Padrão: ligado.
# Desligue com 0, false, off ou no e reinicie o contêiner (sem novo build). Ver docs/adr/0002 e docs/deploy.md
FEATURE_MCP=true
# FEATURE_DOCS liga o Swagger UI em /docs. Padrão: DESLIGADO (o staging liga pelo compose).
FEATURE_DOCS=false

# ---- Regras (valores iniciais; editáveis em Ajustes) ----
# R$/kWh para estimar economia
TARIFA_KWH=0.95
TZ=America/Sao_Paulo
POLL_MINUTES=2
# quantos dias de leituras detalhadas o worker mantém (os totais diários ficam)
READINGS_RETENTION_DAYS=90
REPORT_TIME=19:00
# janela em que "offline" é falha (à noite o inversor desliga)
DAYLIGHT_HOURS=7-17
OFFLINE_GRACE_MINUTES=20
API_FAILURE_THRESHOLD=3

# ---- Livoltek (login do app My Livoltek) ----
LIVOLTEK_ACCOUNT=
LIVOLTEK_PASSWORD=
# international = Brasil/Américas | europe | asia
LIVOLTEK_SERVER=international

# ---- Observabilidade ----
# nível dos logs estruturados (pino): trace | debug | info | warn | error
LOG_LEVEL=info

# ---- Demonstração ----
# conta usada por `pnpm demo:session` para gerar o cookie da conta demo (o seed cria a conta 1)
DEMO_ACCOUNT_ID=1

# ---- Testes de integração ----
# banco SEPARADO (o nome precisa terminar em _test: o teste apaga os dados dele).
# Com o docker-compose.local.yml no ar: postgres://solar:solar@localhost:5432/solar_test
TEST_DATABASE_URL=
