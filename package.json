{
  "name": "sol-planet",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @sol/web --filter @sol/worker dev",
    "dev:web": "pnpm --filter @sol/web dev",
    "dev:worker": "pnpm --filter @sol/worker dev",
    "db:generate": "pnpm --filter @sol/db generate",
    "test": "pnpm --filter @sol/worker exec tsx --test ../../tests/*.test.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
